# ==============================================================================
# AI REPO ANALYZER - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and populate your credentials.

# 1. Google Gemini API Key (Required for AI Synthesis & Architectural Analysis)
# Get a free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. GitHub Personal Access Token (Optional - Increases GitHub API rate limits)
# Generate at: https://github.com/settings/tokens (No special scopes required for public repos)
GITHUB_TOKEN=your_github_token_here

# 3. Server Configuration (Optional defaults)
HOST=0.0.0.0
PORT=8000
